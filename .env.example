APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Portal admin is provisioned via seeder only.
# PORTAL_ADMIN_PASSWORD is required in all environments.
# PORTAL_ADMIN_PHONENO is required outside local/testing.
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_EMAIL=admin@example.com
PORTAL_ADMIN_PASSWORD=YourStrongPasswordHere
PORTAL_ADMIN_PHONENO=09XXXXXXXXX
PORTAL_ADMIN_FULLNAME="System Administrator"

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Report PDF rendering
REPORT_PDF_DRIVER=chromium
REPORT_PDF_TIMEOUT=120
REPORT_PDF_NO_SANDBOX=true
REPORT_PDF_WIDTH=8.5
REPORT_PDF_HEIGHT=13
REPORT_PDF_UNIT=in

# ─── Loan Workflow ────────────────────────────────────────────────
# IMPORTANT: Change LOAN_WORKFLOW_DOCUMENT_DISK to 's3' or a remote
# disk in production. Using 'local' means generated loan documents
# are stored on the app server and will be lost on redeploy.

# Document storage
LOAN_WORKFLOW_DOCUMENT_DISK=local
# LOAN_WORKFLOW_DOCUMENT_DISK=s3
LOAN_WORKFLOW_DOCUMENT_DIRECTORY=loan-request-documents
LOAN_WORKFLOW_TEMP_DIRECTORY=tmp/loan-workflow
LOAN_WORKFLOW_TEMP_RETENTION_HOURS=24

# Queue names — must match your queue worker configuration
LOAN_WORKFLOW_NOTIFICATION_QUEUE=loan-workflow
LOAN_WORKFLOW_NOTIFICATION_SMS_QUEUE=loan-workflow-notifications
LOAN_WORKFLOW_NOTIFICATION_MAIL_QUEUE=loan-workflow-notifications

# Notification delivery behaviour
LOAN_WORKFLOW_NOTIFICATION_TRIES=5
LOAN_WORKFLOW_NOTIFICATION_TIMEOUT=120
LOAN_WORKFLOW_NOTIFICATION_BACKOFF_SECONDS=60,300,900
LOAN_WORKFLOW_NOTIFICATION_REMINDER_AFTER_DAYS=3
LOAN_WORKFLOW_NOTIFICATION_MAX_REMINDERS=1
LOAN_WORKFLOW_ACTION_LINK_TTL_HOURS=168

# Workload monitoring
LOAN_WORKFLOW_OFFICER_WORKLOAD_WARNING_THRESHOLD=30

# WIBS encoding
LOAN_WORKFLOW_WIBS_STALE_DAYS=5

# Data retention
LOAN_WORKFLOW_RETENTION_YEARS=5

# Reporting
LOAN_WORKFLOW_REPORT_AGING_DAYS=3
